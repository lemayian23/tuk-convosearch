# Frontend build-time configuration.
#
# In production the SPA is served by the API itself, so this file is not
# needed and VITE_API_BASE stays empty (same origin, no CORS).
# Set it only when the UI runs somewhere else, e.g. a phone testing against
# your laptop: VITE_API_BASE=http://192.168.1.20:8000

VITE_API_BASE=

# Where `npm run dev` proxies /api requests to.
VITE_DEV_API=http://127.0.0.1:8000
