# =====================================================================
# TUK-ConvoSearch deployment configuration
# =====================================================================
#
# HOW THIS FILE WORKS
#   1. Copy it to the repo root:   cp deploy/.env.example .env
#   2. Edit the four values marked [CHANGE ME]. Everything else has a
#      working default.
#   3. `chmod 600 .env` — it will contain a signing key and an admin password.
#
#   Every setting below maps 1:1 to a field in app/config.py, which is a
#   pydantic-settings model with env_prefix="TUK_". So the variable name is
#   always TUK_ + the UPPER_SNAKE_CASE form of the field, and the default in
#   the comment is the code default (not necessarily the value shipped here).
#   Unknown TUK_* variables are ignored (extra="ignore"), so typos fail
#   silently — copy names from this file rather than typing them.
#
#   Compose reads the REPO-ROOT .env two ways:
#     - deploy/docker-compose.yml passes it into the app container as env vars
#       (env_file: .env), and interpolates ${SITE_ADDRESS}/${WWW_ADDRESS} for Caddy;
#     - running the app outside Docker picks it up directly, because
#       app/config.py declares env_file=".env" relative to the working directory.
#   It is git-ignored (see .gitignore: `.env`). Never commit the real one.
#
#   Do NOT put quotes around values. Do not put spaces around `=`. A line
#   beginning with # is a comment.
# =====================================================================


# ---------------------------------------------------------------------
# Caddy / TLS  [CHANGE ME]
# ---------------------------------------------------------------------
# The hostname Caddy requests the Let's Encrypt certificate for. It MUST be an
# A record pointing at this VPS's public IP before Caddy can obtain a cert —
# Let's Encrypt validates the public address of a domain name and cannot
# validate localhost, an IP address, or a name that still points elsewhere.
# For local testing without DNS, set SITE_ADDRESS=localhost and Caddy will use
# an internal CA that your browser will not trust (fine for curl -k).
SITE_ADDRESS=ask.lemayian.com

# Optional alias Caddy redirects to SITE_ADDRESS. If you have not created a DNS
# record for it, nothing happens and this is harmless.
#
# It MUST NOT equal SITE_ADDRESS: the Caddyfile then declares one hostname
# twice, and Caddy exits during startup without logging an error line, so the
# container just restarts forever. When testing with SITE_ADDRESS=localhost,
# use a different name here (deploy/deploy.sh refuses the duplicate).
WWW_ADDRESS=www.lemayian.com


# ---------------------------------------------------------------------
# Application identity
# ---------------------------------------------------------------------
# [CHANGE ME before first boot] development | production | test.
# "production" switches on the boot-time safety validator in app/config.py:
# it refuses to start unless TUK_SECRET_KEY is >= 32 characters AND
# TUK_CORS_ORIGINS does not contain "*".
TUK_ENVIRONMENT=production

# Canonical public URL. Reported by /api/health so a readiness check tells you
# which host this deployment believes it is reachable on; keep it accurate so
# future share links and redirects have one place to come from.
TUK_PUBLIC_URL=https://ask.lemayian.com

# Comma-separated browser origins allowed to call the API.
# Leave EMPTY in production: the student SPA and the admin panel are served by
# the same origin as the API (app/main.py mounts web/dist at / and admin/dist
# at /admin), so there is no cross-origin request to allow. A "*" value is
# rejected outright in production mode. Set it only for local dev, when Vite
# runs on 5173 and the API on 8000:
#   TUK_CORS_ORIGINS=http://localhost:5173
TUK_CORS_ORIGINS=

# Code default: app_name="TUK-ConvoSearch", version="4.0.0".
# TUK_APP_NAME and TUK_VERSION are reported by /api/config, /api/info and the
# health payloads; changing version here is cosmetic (it does not change the
# image tag) but it is a real setting, so it is listed for completeness.
#TUK_APP_NAME=TUK-ConvoSearch
#TUK_VERSION=4.0.0


# ---------------------------------------------------------------------
# Security  [CHANGE ME — the app will not boot in production without it]
# ---------------------------------------------------------------------
# JWT signing key. MUST be at least 32 characters or TUK_ENVIRONMENT=production
# raises ValueError at import time (see the _check_production_safety model
# validator in app/config.py). Generate one per environment and never reuse it:
#
#     openssl rand -hex 32
#
# Rotating it invalidates every logged-in admin session (they just log in
# again). Keep it out of git, out of your shell history, out of screenshots.
TUK_SECRET_KEY=REPLACE_ME_WITH_OPENSSL_RAND_HEX_32

# Admin lifetime of a login token, in minutes. 480 = one working day, chosen so
# an administrator logging in at 8am is not re-prompted mid-session. Longer
# values are less safe on a shared/library machine.
#TUK_ACCESS_TOKEN_EXPIRE_MINUTES=480

# First admin account, created automatically at boot ONLY when both values are
# set AND the users table is empty (app/services/auth.py
# ensure_bootstrap_admin). The password must be at least 12 characters and at
# most 72 bytes (bcrypt limit enforced by password_policy_error).
# If you leave these blank, the instance boots with NO accounts and you create
# the first admin from the CLI instead — which is the safer default:
#   docker compose -f deploy/docker-compose.yml exec app \
#     python scripts/create_admin.py --email you@tuk.ac.ke
TUK_BOOTSTRAP_ADMIN_EMAIL=
TUK_BOOTSTRAP_ADMIN_PASSWORD=


# ---------------------------------------------------------------------
# Ollama
# ---------------------------------------------------------------------
# [CHANGE ME only if you leave the shipped compose network]
# Inside docker-compose.yml this MUST be http://ollama:11434 — the Docker DNS
# name of the ollama service. `http://localhost:11434` (the code default) is
# wrong in Docker: localhost inside the app container is the app itself, which
# has no Ollama. Ollama's port is deliberately not published on the host, so
# 127.0.0.1:11434 will also fail from the host.
# If you ever run Ollama directly on the VPS (not in Docker), use
# http://172.17.0.1:11434 or the host's LAN address.
TUK_OLLAMA_HOST=http://ollama:11434

# The model that writes the answers students read. Picked for an 8 GB CPU box;
# run `deploy/pull-models.sh --bench` on YOUR hardware before changing it — the
# difference between 1b and 7b on CPU is usually 4x latency for a modest quality
# gain, and the decision table is printed by that script.
TUK_OLLAMA_MODEL=llama3.2:1b

# A second, slightly stronger model used only for the Critic/expander steps
# (app/services/pipelines.py passes it as critic_model). When TUK_CRITIC_MODE is
# "heuristic" this is never called, so you can avoid pulling it on a small box.
# Set it equal to TUK_OLLAMA_MODEL if you want exactly one model resident.
TUK_OLLAMA_REASONING_MODEL=llama3.2:3b

# Code default: embedding_model="all-MiniLM-L6-v2", embedding_dimension=384.
# The weights are BAKED INTO THE IMAGE at build time (deploy/Dockerfile), so
# changing this without rebuilding the image makes the app try to download the
# model at boot and fail offline.
#TUK_EMBEDDING_MODEL=all-MiniLM-L6-v2
#TUK_EMBEDDING_DIMENSION=384


# ---------------------------------------------------------------------
# Throughput on a small VPS  [THE SECTION THAT DECIDES WHETHER IT STAYS UP]
# ---------------------------------------------------------------------
# How many questions generate at the same time. The app keeps a thread-pool of
# exactly this size (app/services/chat.py); when it is full a student gets a
# clean HTTP 503 "All N model slots are busy. Please try again in a moment."
# rather than an OOM kill. Each slot is a full inference pass, so this number
# costs RAM, not just CPU.
#
#   VPS RAM | TUK_MAX_CONCURRENT_LLM_CALLS | notes
#   --------+------------------------------+--------------------------------
#    4 GB   | 1                            | llama3.2:1b only; queue waits
#    8 GB   | 2                            | default; llama3.2:1b or 3b
#   16 GB   | 4                            | qwen2.5:7b: use 2, a 7b pass is
#                                           | large enough on its own
#
# Rule of thumb: model size in GB * ~1.4 for KV cache and context, then divide
# what is left by ~4 GB. If you are unsure, set 1. One slow answer beats four
# crashed containers.
TUK_MAX_CONCURRENT_LLM_CALLS=2

# Wall-clock budget for one model call, measured from the moment the request is
# sent to Ollama. Prefill is the part people forget: on CPU this corpus's 924-
# token prompt took 41.5s to evaluate before a single token was written. The
# retrieval knobs below exist to keep this number reachable - with the default
# pruning a TU-K answer sends ~430 prompt tokens, and a full 320-token answer
# at ~5 tok/s then needs ~70s, so 120 has about 1.5x to spare on this box.
# Caddy deliberately puts no deadline on the proxied stream (see the Caddyfile),
# so this is the only thing that stops a stuck generation.
#TUK_LLM_TIMEOUT_SECONDS=120

# How long a request waits for a free slot before giving up with 503. Keep this
# SHORTER than the browser's patience: a student who is going to be told "try
# again" should be told in ~45s, not after 3 minutes of spinner.
#TUK_LLM_QUEUE_TIMEOUT_SECONDS=45

# How long Ollama keeps the model resident after the last request. 30m covers
# the gaps between questions in a classroom; shorter saves RAM on a shared box,
# longer saves students a cold reload.
#TUK_LLM_KEEP_ALIVE=30m

# Load the model at container start instead of making the first student pay for
# it. Costs ~30-90s of boot time. Turn it off only if the box is so tight that
# an idle resident model hurts.
TUK_WARM_MODEL_ON_BOOT=true

# Generation shape (code defaults shown). num_ctx is the biggest RAM lever:
# context tokens are what push a 3b model past 4 GB. Only raise it if answers
# start ignoring the middle of a long source document.
#TUK_SYNTHESIS_NUM_CTX=4096
#TUK_SYNTHESIS_NUM_PREDICT=320
#TUK_SYNTHESIS_TEMPERATURE=0.2
#TUK_SYNTHESIS_REPEAT_PENALTY=1.1


# ---------------------------------------------------------------------
# Retrieval / answer pipeline (code defaults; tune from the query logs)
# ---------------------------------------------------------------------
#TUK_CHUNK_SIZE=800
#TUK_CHUNK_OVERLAP=160
#TUK_TOP_K=5
#TUK_MAX_SOURCES=3
#TUK_HISTORY_TURNS=4

# How much of the retrieved material reaches the prompt, and therefore how long
# a student stares at a spinner. llama3.2:1b on CPU prefilled at ~22 tokens/s:
# this corpus's 924-token prompt cost 41.5s before the first word appeared, the
# 432-token one costs 20.0s. top_k stays 5 (recall); these prune after ranking -
#   max_chunks_per_source  chunks of ONE document, 0 = unlimited
#   min_relevance_margin   drop chunks this far below the best score, 0 = off
# The eval set still passes 15/17 either way (grounding checks move 15/17 ->
# 14/17 on the shorter prompt: one answer, inside the noise of a sampled model).
# Widen these back towards off if answers start missing a fact that IS in the
# documents, and re-measure with ./deploy/pull-models.sh --bench.
#TUK_MAX_CHUNKS_PER_SOURCE=2
#TUK_MIN_RELEVANCE_MARGIN=0.05

# heuristic = fast token-overlap grounding check, no extra model call.
# llm      = the reasoning model judges grounding: better at catching fluent
#            nonsense, but it doubles the model calls per answer. On a small
#            VPS stay on heuristic; /api/admin/stats `ungrounded_answers` tells
#            you whether you need to switch.
TUK_CRITIC_MODE=heuristic
#TUK_CRITIC_OVERLAP_THRESHOLD=0.4


# ---------------------------------------------------------------------
# Abuse limits
# ---------------------------------------------------------------------
# Per-client fixed-window limit (app/services/rate_limit.py) counted by IP from
# X-Forwarded-For. The effective allowance is per_minute + burst. These are
# in-process counters, which is another reason the stack runs exactly one
# uvicorn worker. 20+8 questions/minute/student is well above real usage.
TUK_RATE_LIMIT_PER_MINUTE=20
#TUK_RATE_LIMIT_BURST=8

# Longest question accepted (silently truncated by the chat route).
#TUK_MAX_QUESTION_CHARS=1000

# Trust X-Forwarded-For. MUST stay `true` behind Caddy, otherwise every student
# in a computer lab shares Caddy's container IP and one classroom exhausts the
# limit for everyone. Set it to `false` the moment you publish port 8000
# directly, because then the header can be spoofed to dodge the limiter.
TUK_TRUST_FORWARDED_FOR=true


# ---------------------------------------------------------------------
# Storage paths
# ---------------------------------------------------------------------
# These are ABSOLUTE PATHS INSIDE THE APP CONTAINER. The image's workdir is
# /srv/app, so the code defaults resolve to exactly the values below — keep
# them unless you also change the `volumes:` binds in docker-compose.yml.
# The host side is ./data and ./corpus at the repo root (i.e.
# /opt/tuk-convosearch/data, /opt/tuk-convosearch/corpus).
#
# data_dir holds tuk_convosearch.db (SQLite: documents, chunks + vectors,
# sessions, messages, query log). That one file is the entire durable store —
# it is what deploy/backup.sh protects.
#TUK_DATA_DIR=/srv/app/data

# corpus_dir holds the source documents. The app writes uploads here and reads
# it for `ingest-all`. Note it is /srv/app/corpus/tuk, not /srv/app/corpus: the
# compose bind mounts the repo's ./corpus directory, so the `tuk` subdirectory
# has to exist on the host too (`mkdir -p corpus/tuk` in the runbook).
#TUK_CORPUS_DIR=/srv/app/corpus/tuk

# Snapshot for the optional "cancer" literature pipeline: a directory holding
# faiss_index.bin + metadata.json (JSON on purpose - the old metadata.pkl was a
# code-execution surface waiting for someone to commit a hostile file). It is
# excluded from git and from the image (.dockerignore), so it only exists here
# if you build it or rsync it over and mount it in docker-compose.yml.
#TUK_PUBMED_INDEX_DIR=/srv/app/pubmed_index

# Where the built bundles are looked for inside the container. Both directories
# are bind-mounted by compose; if you do not mount them the app redirects / to
# /docs instead of serving a UI.
#TUK_WEB_DIST_DIR=/srv/app/web/dist
#TUK_ADMIN_DIST_DIR=/srv/app/admin/dist

# Largest upload the API accepts, in MB. /api/admin/documents answers 413 above
# this, and Caddy refuses 20 MB+ at the edge, so keep this <= 20.
#TUK_MAX_UPLOAD_MB=15


# ---------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------
# DEBUG shows every retrieved chunk and is unreadable on a busy box, but is the
# single most useful thing when an answer looks wrong.
#TUK_LOG_LEVEL=INFO
