# Vite loads this file automatically for `npm run dev` (mode=development).
# It is tracked in git on purpose: it contains no secrets, only the address of a
# localhost API, and without it local development 404s against the dev server.
#
# Production builds deliberately get NO value here: admin/.env.production is not
# created, so `import.meta.env.VITE_API_BASE` is undefined and App.jsx falls back
# to "" (same origin). That is what makes the single-origin Caddy deployment work
# with zero CORS configuration.
VITE_API_BASE=http://localhost:8000
